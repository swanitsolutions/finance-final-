# ==============================================================================
# LoanEase — Loan & EMI Financial Management System Environment Configuration
# ==============================================================================

# Application Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV="development"

# Application Brand Display Name
VITE_APP_NAME="LoanEase Financial Management"

# Default Currency ISO Symbol & Code
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_CURRENCY_SYMBOL="₹"

# Backend REST API Service Endpoint (Django REST / Node.js)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Client Session Token Expiry Duration (in hours)
VITE_SESSION_EXPIRY_HOURS=24

# Maximum Permitted File Upload Size (in bytes, 5MB = 5242880)
VITE_MAX_UPLOAD_SIZE_BYTES=5242880

# Audit Logging & Client Telemetry Toggle ('true' | 'false')
VITE_ENABLE_AUDIT_LOGS="true"

# Rate Limiting: Max requests permitted per minute per client IP
VITE_RATE_LIMIT_PER_MINUTE=100

# Google AI Studio / Gemini API Integration (injected automatically in preview)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio Applet Hosted URL (injected automatically at runtime)
APP_URL="MY_APP_URL"
